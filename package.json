{
  "name": "slyfox",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that summarizes terms and conditions and flags the catches.",
  "license": "MIT",
  "author": "Siddharth Chillale",
  "homepage": "https://github.com/SiddharthChillale/slyfox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiddharthChillale/slyfox.git"
  },
  "bugs": {
    "url": "https://github.com/SiddharthChillale/slyfox/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "build": "node scripts/build.ts",
    "build:safari": "scripts/build-safari.sh",
    "lint:firefox": "web-ext lint --source-dir dist/firefox"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "web-ext": "^10.7.0"
  }
}
